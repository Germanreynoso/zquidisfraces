# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
# "anon" (legacy) o "publishable" key. Es pública: la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" (legacy) o "secret" key. SOLO servidor: nunca la expongas ni la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
