# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Clave "publishable" (sb_publishable_…). Es pública: la seguridad la da RLS.
# (Proyectos viejos: también se acepta NEXT_PUBLIC_SUPABASE_ANON_KEY con la clave "anon".)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave "secret" (sb_secret_…) o "service_role". SOLO servidor: nunca la expongas ni la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional, solo para `pnpm db:apply` (migraciones + datos de prueba). Botón "Connect" → Session pooler → URI.
SUPABASE_DB_URL=
